facts = {
    ("Owns", "A", "T1"),
    ("Missile", "T1"),
    ("American", "Robert"),
    ("Enemy", "A", "America")
}

rules = [

    (
        [("Missile", "?x")],
        ("Weapon", "?x")
    ),

    (
        [("Enemy", "?x", "America")],
        ("Hostile", "?x")
    ),

    (
        [("Missile", "?x"),
         ("Owns", "A", "?x")],
        ("Sells", "Robert", "?x", "A")
    ),

    (
        [("American", "?p"),
         ("Weapon", "?q"),
         ("Sells", "?p", "?q", "?r"),
         ("Hostile", "?r")],
        ("Criminal", "?p")
    )
]

def match(pattern, fact, substitution):

    if pattern[0] != fact[0]:
        return None

    if len(pattern) != len(fact):
        return None

    substitution = substitution.copy()

    for p, f in zip(pattern[1:], fact[1:]):

        if p.startswith("?"):

            if p in substitution:
                if substitution[p] != f:
                    return None

            else:
                substitution[p] = f

        elif p != f:
            return None

    return substitution

def find_matches(conditions, facts):

    results = [{}]

    for condition in conditions:

        new_results = []

        for substitution in results:

            for fact in facts:

                matched = match(
                    condition,
                    fact,
                    substitution
                )

                if matched is not None:
                    new_results.append(matched)

        results = new_results

        if not results:
            break

    return results

def forward_chaining(facts, rules, goal):

    facts = set(facts)

    changed = True

    while changed:

        changed = False

        for conditions, conclusion in rules:

            substitutions = find_matches(
                conditions,
                facts
            )

            for substitution in substitutions:

                new_fact = tuple(
                    substitution.get(item, item)
                    for item in conclusion
                )

                if new_fact not in facts:

                    facts.add(new_fact)
                    changed = True

                    print("New Fact Generated:", new_fact)

                if new_fact == goal:
                    print("\nGoal Proved!")
                    return True

    print("\nGoal Cannot Be Proved.")
    return False

goal = ("Criminal", "Robert")
print("Initial Facts:")

for fact in sorted(facts):
    print(fact)
print("\nForward Chaining Process:\n")
forward_chaining(facts, rules, goal)
