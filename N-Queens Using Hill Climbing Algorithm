import random

def conflicts(board):
    count = 0
    n = len(board)

    for i in range(n):
        for j in range(i + 1, n):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                count += 1

    return count


def print_board(board):
    n = len(board)

    for row in range(n):
        for col in range(n):
            if board[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()


def hill_climbing(board):
    n = len(board)
    step = 1

    while True:
        current = conflicts(board)

        print("\nStep:", step)
        print("Queen Positions:", board)
        print("Number of Conflicts:", current)

        if current == 0:
            return board

        best = current
        best_moves = []

        for col in range(n):
            for row in range(n):
                if row != board[col]:
                    neighbor = board[:]
                    neighbor[col] = row

                    value = conflicts(neighbor)

                    if value < best:
                        best = value
                        best_moves = [(col, row, neighbor)]

                    elif value == best and value < current:
                        best_moves.append((col, row, neighbor))

        if best == current:
            board = [random.randint(0, n - 1) for _ in range(n)]
            print("New Positions:", board)

        else:
            col, row, board = random.choice(best_moves)

            print("Moving Queen in Column", col, "to Row", row)
            print("New Conflicts:", conflicts(board))

        step += 1


n = int(input("Enter number of queens: "))

if n < 4:
    print("Enter N >= 4")

else:
    board = list(map(int, input("Enter queen positions: ").split()))

    if len(board) != n or any(x < 0 or x >= n for x in board):
        print("Invalid positions!")

    else:
        print("\nInitial Board:")
        print_board(board)

        print("\nInitial Conflicts:", conflicts(board))

        solution = hill_climbing(board)

        print("\n========== FINAL SOLUTION ==========")
        print("Final Queen Positions:", solution)
        print("Final Conflicts:", conflicts(solution))

        print("\nFinal Chessboard:")
        print_board(solution)
