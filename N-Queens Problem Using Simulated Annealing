import random
import math

def conflicts(board):
    count = 0
    n = len(board)

    for i in range(n):
        for j in range(i + 1, n):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                count += 1

    return count


def print_board(board):
    n = len(board)

    for row in range(n):
        for col in range(n):
            if board[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()


def simulated_annealing(board):
    n = len(board)

    temperature = 100
    cooling_rate = 0.95
    step = 1

    best = board[:]
    best_conflicts = conflicts(board)

    while temperature > 0.01 and best_conflicts > 0:

        neighbor = board[:]

        col = random.randint(0, n - 1)
        row = random.randint(0, n - 1)

        while row == neighbor[col]:
            row = random.randint(0, n - 1)

        neighbor[col] = row

        current_cost = conflicts(board)
        new_cost = conflicts(neighbor)

        delta = new_cost - current_cost

        if delta < 0 or random.random() < math.exp(-delta / temperature):
            board = neighbor

            print("\nStep:", step)
            print("Queen Positions:", board)
            print("Conflicts:", new_cost)
            print("Temperature:", round(temperature, 2))

        if conflicts(board) < best_conflicts:
            best = board[:]
            best_conflicts = conflicts(board)

        temperature *= cooling_rate
        step += 1

    return best


n = int(input("Enter number of queens: "))

if n < 4:
    print("Enter N >= 4")

else:
    board = list(map(int, input("Enter queen positions: ").split()))

    if len(board) != n or any(x < 0 or x >= n for x in board):
        print("Invalid positions!")

    else:
        print("\nInitial Board:")
        print_board(board)

        print("\nInitial Conflicts:", conflicts(board))

        solution = simulated_annealing(board)

        print("\n========== FINAL SOLUTION ==========")
        print("Final Queen Positions:", solution)
        print("Final Conflicts:", conflicts(solution))

        print("\nFinal Chessboard:")
        print_board(solution)
