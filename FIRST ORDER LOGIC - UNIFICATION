def is_variable(x):
    
    return isinstance(x, str) and x.startswith("?")

def apply_substitution(term, subst):

    while is_variable(term) and term in subst:
        term = subst[term]

    return term


def unify(expr1, expr2, subst=None):

    if subst is None:
        subst = {}

    expr1 = tuple(
        apply_substitution(x, subst)
        if i > 0 else x
        for i, x in enumerate(expr1)
    )

    expr2 = tuple(
        apply_substitution(x, subst)
        if i > 0 else x
        for i, x in enumerate(expr2)
    )

    if expr1 == expr2:
        return subst

    if expr1[0] != expr2[0]:
        return None

    if len(expr1) != len(expr2):
        return None

    for a, b in zip(expr1[1:], expr2[1:]):

        a = apply_substitution(a, subst)
        b = apply_substitution(b, subst)

        if a == b:
            continue

        if is_variable(a):

            if a in b:
                return None

            subst[a] = b

        elif is_variable(b):

            if b in a:
                return None

            subst[b] = a
        else:
            return None

    return subst

print("FIRST ORDER LOGIC - UNIFICATION")

expr1 = ("Eats", "?x", "Apple")

expr2 = ("Eats", "Riya", "?y")

print("\nExpression 1:", expr1)

print("Expression 2:", expr2)

result = unify(expr1, expr2)

if result is not None:

    print("\nUnification Successful!")
    print("Substitution Set:")

    for variable, value in result.items():
        print(variable, "=", value)
else:
    print("\nUnification Failed!")
